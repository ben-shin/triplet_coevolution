include setup_local.sh
include src/_triplet_build.py
include README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
include .github/workflows/ci.yml
recursive-include requirements *.txt
recursive-include tools/release *.py
recursive-include docs *.md
recursive-include benchmarks *.py
include benchmarks/gatabc_manifest.json
recursive-include benchmarks *.md
include benchmarks/experimental_*.json
include benchmarks/experimental_structure_metrics.tsv
include benchmarks/independent_cohort_*.json
include benchmarks/independent_cohort_*.gz
include benchmarks/independent_evaluation_policy.json
include benchmarks/independent_*_metrics.json
include benchmarks/independent_*_metrics.tsv
include benchmarks/independent_*_metrics.json.gz
include benchmarks/recovery_matrix_*.json
include benchmarks/plm_geometry_followup_policy.json
include benchmarks/plm_geometry_followup_results.json.gz
prune results
prune input
include input/README.md
global-exclude *.py[cod]
